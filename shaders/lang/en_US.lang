option.DDA_SHAPE_LOD_DISTANCE=Detailed Shape Distance
option.DDA_SHAPE_LOD_DISTANCE.comment=Distance at which analytic occluders use exact grouped bounds. Visibility is preserved.
option.DDA_DEBUG=Voxel Capture Debug
value.DDA_DEBUG.0=Off
value.DDA_DEBUG.1=Inside Surface
value.DDA_DEBUG.2=Outside Surface
value.DDA_DEBUG.3=Direct Light Only
value.DDA_DEBUG.4=Profile: No Ray Tracing
value.DDA_DEBUG.5=Profile: No Direct Lighting
