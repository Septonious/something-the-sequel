#ifndef DDA_SHAPE_IDS_DEFINED
#define DDA_SHAPE_IDS_DEFINED
// Generated by tools/generate_dda_models.py; raw block ID -> original shading material.
int ddaBaseMaterial(int id) {
    if (id >= 11000 && id < 11512) return 0;
    if (id >= 11512 && id < 12024) return 10002;
    if (id >= 12024 && id < 12536) return 20300;
    if (id >= 12536 && id < 13048) return 20302;
    if (id >= 13048 && id < 13560) return 20303;
    if (id >= 13560 && id < 14072) return 20304;
    if (id >= 14072 && id < 14584) return 20305;
    if (id >= 14584 && id < 15096) return 20306;
    if (id >= 15096 && id < 15608) return 20307;
    if (id >= 15608 && id < 16120) return 20308;
    if (id >= 16120 && id < 16632) return 20309;
    if (id >= 16632 && id < 17144) return 20310;
    if (id >= 17144 && id < 17656) return 20314;
    if (id >= 17656 && id < 18168) return 20315;
    if (id >= 18168 && id < 18680) return 20317;
    if (id >= 18680 && id < 19192) return 20320;
    if (id >= 19192 && id < 19704) return 20322;
    return id;
}
uint ddaShapeFromBlock(uint id) {
    if (id >= 1000u && id < 9704u) return 256u + ((id - 1000u) & 511u);
    return 0u;
}
#endif
